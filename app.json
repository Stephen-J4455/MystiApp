{
  "expo": {
    "name": "Mystiwanebiz",
    "slug": "mystiwan-e-business",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/mystiwan.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/mystiwan.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stephenj2.mystiwanebusiness",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "icon": "./assets/mystiwan.png",
      "edgeToEdgeEnabled": true,
      "package": "com.stephenj2.mystiwanebusiness",
      "googleServicesFile": "./google-services.json",
      "permissions": ["RECEIVE_BOOT_COMPLETED", "VIBRATE", "WAKE_LOCK"]
    },
    "notification": {
      "icon": "./assets/mystiwan.png",
      "color": "#ffffff",
      "androidMode": "default",
      "androidCollapsedTitle": "Mystiwan-E-Business",
      "iosDisplayInForeground": true
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/mystiwan.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "sounds": [],
          "mode": "production",
          "android": {
            "useNextNotificationsApi": true
          }
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "mystiwanebusiness",
    "web": {
      "favicon": "./assets/mystiwan.png",
      "bundler": "metro",
      "name": "Mystiwan E-Business",
      "shortName": "Mystiwan",
      "description": "Manage your Mystiwan E-Business account securely and conveniently.",
      "lang": "en",
      "themeColor": "#006769",
      "backgroundColor": "#FFFFFF",
      "display": "standalone",
      "scope": "/",
      "startUrl": "/",
      "manifest": {
        "name": "Mystiwan E-Business",
        "short_name": "Mystiwan",
        "description": "Manage your Mystiwan E-Business account securely and conveniently.",
        "lang": "en",
        "start_url": "/",
        "scope": "/",
        "display": "standalone",
        "orientation": "portrait",
        "theme_color": "#006769",
        "background_color": "#FFFFFF",
        "icons": [
          {
            "src": "/assets/pwa-icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
          },
          {
            "src": "/assets/pwa-icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
          }
        ]
      }
    },
    "extra": {
      "eas": {
        "projectId": "047febb0-856a-4690-8732-5655e264fab6"
      }
    }
  }
}
