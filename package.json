{
  "name": "mystiwan-e-business",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "env:dev": "cross-env EXPO_PUBLIC_APP_ENV=development expo start",
    "env:test": "cross-env EXPO_PUBLIC_APP_ENV=test expo start",
    "env:prod": "cross-env EXPO_PUBLIC_APP_ENV=production expo start",
    "android:dev": "cross-env EXPO_PUBLIC_APP_ENV=development expo run:android",
    "android:prod": "cross-env EXPO_PUBLIC_APP_ENV=production expo run:android",
    "check:imports": "node check-imports.cjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform web && node scripts/copy-web-assets.js",
    "build:android:development": "eas build --platform android --profile development",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "build:ios:development": "eas build --platform ios --profile development",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:production": "eas build --platform ios --profile production",
    "deploy": "gh-pages -d dist",
    "deploy:test": "pwsh supabase/scripts/deploy.ps1 -Env test",
    "deploy:prod": "pwsh supabase/scripts/deploy.ps1 -Env production -IUnderstandThisDeploysToProduction",
    "deploy:test:bash": "bash supabase/scripts/deploy.sh test",
    "deploy:prod:bash": "bash supabase/scripts/deploy.sh production -IUnderstandThisDeploysToProduction",
    "functions:deploy:test": "pwsh supabase/scripts/deploy.ps1 -Env test -SkipMigrations",
    "functions:deploy:prod": "pwsh supabase/scripts/deploy.ps1 -Env production -SkipMigrations -IUnderstandThisDeploysToProduction",
    "db:push:test": "pwsh supabase/scripts/deploy.ps1 -Env test -SkipFunctions",
    "db:push:prod": "pwsh supabase/scripts/deploy.ps1 -Env production -SkipFunctions",
    "secrets:set:test": "pwsh supabase/scripts/set-secrets.ps1 -Env test",
    "secrets:set:prod": "pwsh supabase/scripts/set-secrets.ps1 -Env production",
    "functions:test:test": "pwsh supabase/scripts/test-functions.ps1 -Env test",
    "functions:test:prod": "pwsh supabase/scripts/test-functions.ps1 -Env production"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/public-sans": "^0.4.2",
    "@expo/cli": "^54.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@supabase/supabase-js": "^2.86.0",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "^57.0.2",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-splash-screen": "^57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-chart-kit": "^6.12.0",
    "react-native-keyboard-controller": "^1.21.9",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.2.18",
    "cross-env": "^7.0.3",
    "gh-pages": "^6.3.0",
    "supabase": "^2.117.0",
    "typescript": "~6.0.3"
  }
}
