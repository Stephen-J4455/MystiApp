{
  "name": "mystiwan-e-business",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "deploy": "gh-pages -d dist",
    "deploy:test": "pwsh supabase/scripts/deploy.ps1 -Env test",
    "deploy:prod": "pwsh supabase/scripts/deploy.ps1 -Env production",
    "deploy:test:bash": "bash supabase/scripts/deploy.sh test",
    "deploy:prod:bash": "bash supabase/scripts/deploy.sh production",
    "functions:deploy:test": "pwsh supabase/scripts/deploy.ps1 -Env test -SkipMigrations",
    "functions:deploy:prod": "pwsh supabase/scripts/deploy.ps1 -Env production -SkipMigrations",
    "db:push:test": "pwsh supabase/scripts/deploy.ps1 -Env test -SkipFunctions",
    "db:push:prod": "pwsh supabase/scripts/deploy.ps1 -Env production -SkipFunctions",
    "secrets:set:test": "pwsh supabase/scripts/set-secrets.ps1 -Env test",
    "secrets:set:prod": "pwsh supabase/scripts/set-secrets.ps1 -Env production",
    "functions:test:test": "pwsh supabase/scripts/test-functions.ps1 -Env test",
    "functions:test:prod": "pwsh supabase/scripts/test-functions.ps1 -Env production",
    "env:dev": "cross-env EXPO_PUBLIC_APP_ENV=development expo start",
    "env:test": "cross-env EXPO_PUBLIC_APP_ENV=test expo start",
    "env:prod": "cross-env EXPO_PUBLIC_APP_ENV=production expo start"
  },
  "dependencies": {
    "@expo/cli": "^54.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@supabase/supabase-js": "^2.86.0",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.9",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.15.0"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.1.10",
    "cross-env": "^7.0.3",
    "gh-pages": "^6.3.0",
    "supabase": "^2.117.0",
    "typescript": "~5.9.3"
  }
}
